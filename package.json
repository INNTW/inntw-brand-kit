{
  "name": "@inntw/brand",
  "version": "1.0.0",
  "description": "The INNTW design system — tokens, the mark, and the shared components every INNTW site is built from.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INNTW/inntw-brand-kit.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "assets"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./og": "./src/og.tsx",
    "./assets/*": "./assets/*",
    "./content": "./src/content.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules *.tsbuildinfo"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "peerDependencies": {
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
